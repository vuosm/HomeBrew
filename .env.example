# Public address of the site (used for NOWPayments callbacks and redirects). Must be https in production.
SITE_URL=https://your-domain.com
PORT=3000

# From your NOWPayments dashboard: Settings > Payments > API keys, and Settings > Payments > Instant payment notifications
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Set to true to use the NOWPayments sandbox while testing
NOWPAYMENTS_SANDBOX=false

# Price of lifetime access, in a fiat currency NOWPayments supports (buyers pay the equivalent in crypto)
PRICE_AMOUNT=19
PRICE_CURRENCY=usd

# How long a login lasts on one device
SESSION_DAYS=30
